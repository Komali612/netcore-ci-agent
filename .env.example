# Local dev overrides — NON-SECRET only. In-cluster these come from Helm/k8s.
AGENT_NAME=my-agent
AGENT_LOG_LEVEL=DEBUG

# Give the agent an LLM brain (needed for skills + tools orchestration).
# Without a model it runs the keyless "no-op" brain and does nothing useful.
# AGENT_MODEL=claude-opus-5

# Secrets (e.g. ANTHROPIC_API_KEY) are NOT stored here — inject them from
# Doppler at launch:  doppler run -- python -m agent.main
# (see doppler.yaml in this dir). For local-only experiments you can still
# export them in your shell instead.

# Nested connector config uses __, e.g.:
# AGENT_JIRA__BASE_URL=https://your-org.atlassian.net
